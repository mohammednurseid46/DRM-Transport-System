# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (match in root, Frontend, Backend, or anywhere)
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js & build outputs (match anywhere)
.next/
**/.next/
out/
build/
dist/
/coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
Backend/.env
Frontend/.env*

# vercel & typescript
.vercel
*.tsbuildinfo
next-env.d.ts